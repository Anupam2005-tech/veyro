{
  "name": "@veyro/api",
  "version": "0.0.0",
  "private": true,
  "description": "Veyro Express modular-monolith backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "tsc -b && node --test test/*.cjs",
    "reset-data": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@veyro/contracts": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "exports": {
    "./app": "./dist/app.js",
    "./trips/location-cleanup.service": "./dist/modules/trips/location-cleanup.service.js",
    "./notifications/notification.service": "./dist/modules/notifications/notification.service.js",
    "./package.json": "./package.json"
  }
}
