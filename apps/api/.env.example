# Copy to apps/api/.env — every value is optional for local development.
PORT=4000
NODE_ENV=development
API_BASE_PATH=/api/v1
# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:3000

# Signs session tokens and private document links. Required in production.
SESSION_SECRET=

# Local JSON data store location (default: apps/api/.data).
# VEYRO_DATA_DIR=

# Moves the seeded demo drivers and runs offer-expiry/broadcast sweeps every 4 s.
SIMULATE_DRIVERS=true

# Set to "offline" to skip OSRM routing / Nominatim search and use estimates + the built-in gazetteer.
ROUTING=
GEOCODER=
# OSRM_URL=https://router.project-osrm.org

# Razorpay Test Mode only. Leave empty to use the built-in demo payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Reserved for the Firebase/Google Maps production setup (not used by the local build).
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
GOOGLE_MAPS_SERVER_KEY=
